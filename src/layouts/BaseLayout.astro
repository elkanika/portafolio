---
import "../styles/global.css";

// El sitio se sirve bajo `base: "/portafolio"`, así que las rutas absolutas
// de /public tienen que llevar ese prefijo o dan 404 en GitHub Pages.
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ezequiel Benavidez - Desarrollador Backend | Portfolio" />
    <title>Ezequiel Benavidez | Backend Developer</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <script is:inline>
      // Corre antes del primer pintado: habilita los estados iniciales de GSAP.
      document.documentElement.classList.add("js");
      // Red de seguridad: si el bundle falla, mostramos todo igual.
      // Los <script type="module"> son diferidos, así que `load` ya espera a que
      // el bundle se ejecute (o falle): no hay carrera con un timeout fijo.
      addEventListener("load", function () {
        var el = document.documentElement;
        if (!el.classList.contains("gsap-ready")) el.classList.remove("js");
      });
    </script>
  </head>
  <body>
    <nav class="nav" data-nav>
      <div class="nav-inner">
        <a href="#" class="nav-logo">
          <span>&lt;</span>EB<span> /&gt;</span>
        </a>
        <ul class="nav-links">
          <li><a href="#about"><span class="number">01.</span> Sobre mí</a></li>
          <li><a href="#stack"><span class="number">02.</span> Stack</a></li>
          <li><a href="#experience"><span class="number">03.</span> Experiencia</a></li>
          <li><a href="#projects"><span class="number">04.</span> Proyectos</a></li>
          <li><a href="#contact"><span class="number">05.</span> Contacto</a></li>
        </ul>
      </div>
      <div class="scroll-progress" data-scroll-progress></div>
    </nav>

    <main>
      <slot />
    </main>

    <footer style="text-align: center; padding: 40px 0; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p>Diseñado y construido por Ezequiel Benavidez &copy; {new Date().getFullYear()}</p>
      </div>
    </footer>

    <script>
      import "../scripts/animations";
    </script>
  </body>
</html>